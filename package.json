{
  "name": "@radioactiive/modal-slider-ui",
  "version": "0.1.2",
  "private": false,
  "description": "React UI components (ModalSlider, ModalCard)",
  "license": "MIT",
  "main": "lib/index.cjs",
  "module": "lib/index.esm.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.esm.js",
      "require": "./lib/index.cjs",
      "types": "./lib/index.d.ts"
    }
  },
  "files": [
    "lib"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "dependencies": {
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "28.0.6",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.1",
    "@rollup/plugin-replace": "6.0.2",
    "@rollup/plugin-typescript": "12.1.4",
    "@rollup/plugin-url": "8.0.2",
    "@types/prop-types": "15.7.15",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "cross-env": "10.0.0",
    "dotenv": "17.2.1",
    "gh-pages": "6.3.0",
    "rimraf": "6.0.1",
    "rollup": "2.79.2",
    "rollup-plugin-copy": "3.5.0",
    "rollup-plugin-livereload": "2.0.5",
    "rollup-plugin-postcss": "4.0.2",
    "rollup-plugin-serve": "3.0.0",
    "rollup-plugin-terser": "7.0.2",
    "serve": "14.2.4",
    "typescript": "5.9.2"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development BUILD_TARGET=app rollup -c -w",
    "build:app": "cross-env NODE_ENV=production BUILD_TARGET=app rollup -c",
    "build:lib": "cross-env NODE_ENV=production BUILD_TARGET=lib rollup -c",
    "build": "npm run build:lib"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.services.mts.ru/mkornev/slidegallery"
  },
  "bugs": {
    "url": "https://gitlab.services.mts.ru/mkornev/slidegallery/-/issues"
  },
  "keywords": [
    "react",
    "modal",
    "slider",
    "lightbox",
    "carousel",
    "gallery",
    "ui-library"
  ],
  "author": "Maxim Kornev"
}
