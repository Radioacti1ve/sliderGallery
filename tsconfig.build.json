{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "lib",
    "rootDir": "src/lib",
    "stripInternal": true,
    "preserveSymlinks": false
  },
  "include": ["src/lib/**/*"],
  "exclude": ["src/app/**/*", "src/**/*.test.*", "lib"]
}
